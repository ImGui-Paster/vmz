<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!--
        Theme selector entries for the Appearance preference.

        The *values* are the raw AppCompatDelegate.MODE_NIGHT_* ints as strings,
        so ThemeManager can Integer.parseInt them directly and hand them to
        AppCompatDelegate.setDefaultNightMode without a lookup table:
            -1 = MODE_NIGHT_FOLLOW_SYSTEM
             1 = MODE_NIGHT_NO   (light)
             2 = MODE_NIGHT_YES  (dark)
    -->
    <string-array name="theme_mode_entries">
        <item>@string/theme_mode_system</item>
        <item>@string/theme_mode_light</item>
        <item>@string/theme_mode_dark</item>
    </string-array>

    <string-array name="theme_mode_values">
        <item>-1</item>
        <item>1</item>
        <item>2</item>
    </string-array>

</resources>
