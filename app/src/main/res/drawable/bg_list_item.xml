<?xml version="1.0" encoding="utf-8"?>
<!--
    Selectable row background.

    List rows previously had no background at all, so taps produced no visual
    feedback whatsoever (notably in Root Manager and Script Runner, where a tap
    triggers a confirmation dialog). A ripple over a themed surface fixes that
    and simultaneously gives rows a proper card-like surface in dark mode.
-->
<ripple xmlns:android="http://schemas.android.com/apk/res/android"
    android:color="@color/accent">
    <item android:id="@android:id/mask">
        <shape android:shape="rectangle">
            <solid android:color="@color/surface" />
            <corners android:radius="@dimen/radius_md" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/surface" />
            <corners android:radius="@dimen/radius_md" />
        </shape>
    </item>
</ripple>
