<?xml version="1.0" encoding="utf-8"?>
<!-- Fake-location row. Aligned with item_package.xml. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginStart="@dimen/space_sm"
    android:layout_marginTop="@dimen/space_xs"
    android:layout_marginEnd="@dimen/space_sm"
    android:layout_marginBottom="@dimen/space_xs"
    android:background="@drawable/bg_list_item"
    android:gravity="center_vertical"
    android:minHeight="@dimen/min_touch_target"
    android:orientation="horizontal"
    android:padding="@dimen/space_md">

    <FrameLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content">

        <ImageView
            android:id="@+id/icon"
            android:layout_width="@dimen/list_icon_size"
            android:layout_height="@dimen/list_icon_size"
            android:contentDescription="@string/a11y_app_icon" />

        <com.othershe.cornerlabelview.CornerLabelView
            android:id="@+id/cornerLabel"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:layout_gravity="top|start"
            android:visibility="invisible"
            app:bg_color="@color/accent"
            app:position="left_top"
            app:side_length="22dp"
            app:text="*"
            app:text_color="@color/on_accent" />
    </FrameLayout>

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/space_md"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/name"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:textAppearance="@style/TextAppearance.BlackBox.ListTitle"
            tools:text="Example App" />

        <TextView
            android:id="@+id/fakeLocation"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_xxs"
            android:ellipsize="end"
            android:maxLines="1"
            android:textAppearance="@style/TextAppearance.BlackBox.ListSubtitle"
            tools:text="55.7558, 37.6173" />
    </LinearLayout>

</LinearLayout>
