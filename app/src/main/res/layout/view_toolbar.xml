<?xml version="1.0" encoding="utf-8"?>
<!--
    Shared toolbar.

    The background stays the dark brand colour in both themes (it is the app's
    identity), so on_primary is the correct foreground in day and night alike -
    hence ToolBarColorStyle now inherits ThemeOverlay...Dark.ActionBar, which
    also fixes the overflow menu rendering dark-on-dark in night mode.

    elevation is 0 and a hairline divider is used instead, so the toolbar reads
    as flush with the content rather than casting a shadow onto the list.
-->
<com.google.android.material.appbar.MaterialToolbar xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/toolbar"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@color/primary"
    android:elevation="@dimen/elevation_appbar"
    android:theme="@style/ToolBarColorStyle"
    app:subtitleTextColor="@color/on_primary"
    app:title="@string/app_name"
    app:titleTextColor="@color/on_primary" />
