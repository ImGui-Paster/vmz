<?xml version="1.0" encoding="utf-8"?>
<!--
    RecyclerView item entry animation, driven by a LayoutAnimationController
    (see res/anim/layout_animation_fall_down.xml). Applied to the app grid and
    to the Root Manager / Script Runner lists so freshly loaded content
    cascades in instead of popping.
-->
<set xmlns:android="http://schemas.android.com/apk/res/android"
     android:interpolator="@android:interpolator/decelerate_quint">
    <translate
        android:fromYDelta="14%"
        android:toYDelta="0"
        android:duration="260" />
    <alpha
        android:fromAlpha="0.0"
        android:toAlpha="1.0"
        android:duration="260" />
    <scale
        android:fromXScale="0.96"
        android:toXScale="1.0"
        android:fromYScale="0.96"
        android:toYScale="1.0"
        android:pivotX="50%"
        android:pivotY="50%"
        android:duration="260" />
</set>
